# All data is stored locally in data/autolarp.json — no database setup needed.
# Optional: Gemini API key for the AI assistant (aistudio.google.com/apikey)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-flash-latest
# Optional: ElevenLabs API key so the assistant reads replies aloud (elevenlabs.io → Developers → API Keys)
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Optional
# PORT=8080
