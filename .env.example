# MongoDB connection string (MongoDB Atlas → Connect → Drivers).
# You can also leave this out: `npm start` will ask for it once and save it here.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# Optional: Gemini API key for the AI assistant (aistudio.google.com/apikey)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-flash-latest
# Optional
# MONGODB_DB=autolarp
# PORT=8080
